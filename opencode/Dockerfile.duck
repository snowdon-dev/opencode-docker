# The toolchain base only: it carries no opencode CLI, so it is not runnable on
# its own. The published images are this base plus a version layer
# (Dockerfile.v1 / Dockerfile.v2), which is where the CLI and the helper scripts
# are installed.
ARG OPENCODE_BASE_URL=devsnowdon/opencode-docker
FROM ${OPENCODE_BASE_URL}:empty-base

LABEL dev.snowdon.image.opencode.variant="duck"

ARG USERNAME=other

# ------------------------------------------------------------
# Packages setup
# ------------------------------------------------------------
# Node and Python runtimes on top of the empty base image.
USER root

RUN apk add --no-cache \
    python3>=3.14 \
    py3-pip>=26.1 \
    nodejs>=24.18 \
    npm>=11.12

# Smoke tests for language packages
RUN python3 --version \
    && pip3 --version \
    && node --version \
    && npm --version

# Alpine's /etc/profile resets PATH to the image baseline, dropping user-local
# binary dirs from a login shell. This layer installs node/npm and python/pip
# system-wide, but their userspace installs land under $HOME: `pip install
# --user` and pipx write executables to ${HOME}/.local/bin, `npm i -g --prefix
# ~/.npm-global` writes them to ${HOME}/.npm-global/bin. Re-add both for login
# shells; missing dirs are skipped, so a user who never creates them is
# unaffected.
#
# Every layer ships its own numerically prefixed profile.d script listing every
# user-local bin dir of the images built on it (the dirs its own tools install
# into, plus any a child layer adds), so the distinct name makes the full layer's
# script (50-...) extend this one instead of overwriting it.
RUN mkdir -p /etc/profile.d && cat > /etc/profile.d/40-opencode-user-bin.sh <<'EOF'
if [ -n "${HOME}" ]; then
    for dir in "${HOME}/.local/bin" "${HOME}/.npm-global/bin"; do
        [ -d "${dir}" ] || continue
        case ":${PATH}:" in
            *:"${dir}":*) ;;
            *) export PATH="${dir}:${PATH}" ;;
        esac
    done
    unset dir
fi
EOF

USER $USERNAME
