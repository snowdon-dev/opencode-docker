#!/bin/bash
# Mock docker for the launcher tests.
# Does NOT execute anything. Each invocation is recorded, one per line, to the
# file given in $OPENCODE_TEST_DOCKER_LOG (default: stderr via echo), so tests
# can assert the exact commands the launcher would run.
#
# A few subcommands are scripted to return canned output so downstream logic
# (which reads docker output) still works:
#   compose ps   -> prints a container id
#   docker ps    -> prints one managed container line
#   compose exec ... sh -c <body>  -> echoes the body back as captured output
#   compose exec ... curl ...      -> fails when OPENCODE_TEST_HEALTH_FAIL=1,
#                                     i.e. the in-container health probe says
#                                     "backend not up"
#   compose run ...                -> reads the prompt the launcher pipes in and
#                                     records it as one escaped "stdin: ..." log
#                                     line; when the container runs an io-style
#                                     one-off (io, changes --output) and
#                                     OPENCODE_TEST_IO_OUTPUT is set, writes
#                                     OPENCODE_TEST_IO_PLAN (default "mocked io
#                                     plan") into each listed output, standing
#                                     in for the agent writing the files
set -u

OPENCODE_TEST_DOCKER_LOG="${OPENCODE_TEST_DOCKER_LOG:-}"

mock_log() {
    if [[ -n "$OPENCODE_TEST_DOCKER_LOG" ]]; then
        printf '%s\n' "$*" >>"$OPENCODE_TEST_DOCKER_LOG"
    else
        printf 'MOCK DOCKER: %s\n' "$*"
    fi
}

# Print the ids scripted for one workspace in a "<ws>=<id> <ws>=<id>" map, one
# per line. An unset map prints nothing, as docker does when a label query
# matches nothing (the unquoted expansion splits the scripted list into words).
mock_ls_map() {
    local map="$1" ws="$2"
    [[ -n "$map" ]] || return 0
    local entry
    for entry in ${map}; do
        if [[ "${entry%%=*}" == "$ws" ]]; then
            printf '%s\n' "${entry#*=}"
        fi
    done
}

# Print the ids a `ls --filter label=<key>[=<value>]` query returns: $1 is the
# queried value (empty for a bare label filter), $2 the "<ws>=<id>" map to answer
# it from and $3 the ids to return when no map is scripted for that label. An
# unset map or list prints nothing, as docker does when no resource carries the
# label.
mock_ls_filter() {
    local value="$1" ws_map="$2" ids="$3"
    if [[ -n "$ws_map" ]]; then
        mock_ls_map "$ws_map" "$value"
    elif [[ -n "$ids" ]]; then
        printf '%s\n' ${ids}
    fi
}

# Record the full invocation as a single log line for easy diffing. WORKSPACE_PARENT
# is the launcher's env var for the worktree parent of the workspace, which the
# compose build file turns into the PROJECT_WORKSPACE_PARENT build arg (and so into
# the image's dev.snowdon.opencode.workspace_parent label). It is recorded only
# when set, so the note appears exactly for the worktree launches a test cares
# about.
if [[ "${1:-}" == "compose" && -n "${WORKSPACE_PARENT:-}" ]]; then
    mock_log "docker $* [env WORKSPACE_PARENT=$WORKSPACE_PARENT]"
else
    mock_log "docker $*"
fi

# Record the contents of every compose file the invocation passes with -f when
# a test asks for it (OPENCODE_TEST_OVERRIDE_LOG). The launcher writes its
# generated overrides into a mktemp directory it removes on exit, so this is
# the only point where a test can see what an override actually merges (see
# assert_override_contains in tests/lib/helpers.bash). Each file's lines are
# appended verbatim under a "=== <path>" header.
if [[ -n "${OPENCODE_TEST_OVERRIDE_LOG:-}" ]]; then
    _mock_prev=""
    for _mock_arg in "$@"; do
        if [[ "$_mock_prev" == "-f" && -f "$_mock_arg" ]]; then
            {
                printf '=== %s\n' "$_mock_arg"
                cat "$_mock_arg"
            } >>"$OPENCODE_TEST_OVERRIDE_LOG"
        fi
        _mock_prev="$_mock_arg"
    done
fi

# The invocation as given, kept before the parsing below consumes it: the io
# write-back keys off the container name, which the flag-skipping loops eat.
MOCK_RAW_ARGS="$*"

# Determine the compose subcommand (first positional that is not a flag).
if [[ "$1" == "compose" ]]; then
    shift
    sub=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -p | -f | --project-name | --file) shift 2 ;;
        -*) shift ;;
        *)
            sub="$1"
            shift
            break
            ;;
        esac
    done
    case "$sub" in
    up)
        if [[ "${OPENCODE_TEST_BUILD_FAIL:-}" == "1" ]]; then
            echo "mocked: up FAIL" >&2
            exit 1
        fi
        echo "mocked: up"
        ;;
    down)
        echo "mocked: down"
        ;;
    ps)
        if [[ "${OPENCODE_TEST_NO_CONTAINER:-}" == "1" ]]; then
            # Simulate "no running container" so the launcher falls back to
            # `docker compose run` instead of `exec`.
            exit 0
        fi
        echo "mocked-container-id"
        ;;
    exec)
        # Skip flags, then skip service name, then handle remaining command.
        while [[ $# -gt 0 && "$1" == -* ]]; do shift; done
        [[ $# -gt 0 ]] && shift
        # If the remaining words begin with sh -c <body>, echo the body back so
        # the launcher's command substitution capture works.
        if [[ "${1:-}" == "sh" && "${2:-}" == "-c" ]]; then
            printf '%s\n' "${3:-}"
        elif [[ "${1:-}" == "curl" && "${OPENCODE_TEST_HEALTH_FAIL:-}" == "1" ]]; then
            # The launcher's in-container health probe is a curl run inside the
            # container. Fail it on demand so start exercises the wait path.
            exit 7
        else
            echo "mocked: exec ${*}"
        fi
        ;;
    run)
        # Mirrors exec: after consuming flags/service, if the remaining words
        # begin with sh -c <body>, echo the body back so command-substitution
        # capture works for the one-off (compose run) path too.
        while [[ $# -gt 0 && "$1" == -* ]]; do shift; done
        [[ $# -gt 0 ]] && shift
        if [[ "${1:-}" == "sh" && "${2:-}" == "-c" ]]; then
            printf '%s\n' "${3:-}"
        else
            echo "mocked: run ${*}"
        fi
        # The launcher pipes the task prompt to the container on stdin (bg,
        # scaffold, io). Read it back and record it as a single line with its
        # newlines escaped, so a test can assert which prompt a run was given
        # without breaking the one-command-per-line log.
        if [[ ! -t 0 ]]; then
            _mock_stdin="$(cat)"
            if [[ -n "$_mock_stdin" ]]; then
                mock_log "stdin: ${_mock_stdin//$'\n'/\\n}"
            fi
        fi
        # io-style runs (io, and changes --output): the one-off container's job
        # is to write into the outputs the io override mounts read-write. The
        # mock never runs opencode, so it writes those files itself when a test
        # points at them - gated on the one-off container name, so a leftover
        # variable cannot make an unrelated `compose run` write anywhere. The
        # launcher prepares the outputs before the run (files truncated,
        # directories mkdir'd) and only accepts a non-empty result after it.
        # OPENCODE_TEST_IO_OUTPUT is a newline-separated list (one entry per
        # output); a directory entry gets a file written inside it.
        if [[ ("$MOCK_RAW_ARGS" == *oc-io-* || "$MOCK_RAW_ARGS" == *oc-changes-*) &&
            -n "${OPENCODE_TEST_IO_OUTPUT:-}" ]]; then
            while IFS= read -r _mock_io_path; do
                [[ -n "$_mock_io_path" ]] || continue
                if [[ -d "$_mock_io_path" ]]; then
                    (
                        printf '%s\n' "${OPENCODE_TEST_IO_PLAN:-mocked io plan}" \
                            >"$_mock_io_path/mock-output.md"
                    ) 2>/dev/null || true
                else
                    (
                        printf '%s\n' "${OPENCODE_TEST_IO_PLAN:-mocked io plan}" \
                            >"$_mock_io_path"
                    ) 2>/dev/null || true
                fi
            done <<<"${OPENCODE_TEST_IO_OUTPUT}"
        fi
        ;;
    port)
        # Simulate `docker compose port opencode 4096`, which prints the host
        # mapping for the service's private port. The port is random when the
        # compose file publishes "0:4096"; OPENCODE_TEST_HOST_PORT overrides it.
        # Fails (like a missing mapping / stopped container) on demand.
        if [[ "${OPENCODE_TEST_NO_CONTAINER:-}" == "1" || "${OPENCODE_TEST_PORT_FAIL:-}" == "1" ]]; then
            exit 1
        fi
        printf '0.0.0.0:%s\n' "${OPENCODE_TEST_HOST_PORT:-32768}"
        ;;
    *)
        echo "mocked: compose $sub $*"
        ;;
    esac
elif [[ "$1" == "ps" ]]; then
    shift
    # Simulate "no managed containers" so ls can exercise its empty listing.
    if [[ "${OPENCODE_TEST_NO_CONTAINER:-}" == "1" ]]; then
        exit 0
    fi
    # A discovery scoped to the worktree-parent label finds the worktree-child
    # containers when the test scripts them (OPENCODE_TEST_WORKTREE_CHILD, a
    # space-separated id list, whose parent is the current directory); otherwise
    # it finds nothing — fresh test sandboxes have no worktree-child containers.
    # Honouring the filter keeps the launcher's worktree-child detection in
    # _opencode_args_prepare from mis-reading the generic "c1" mock container as
    # a worktree of the sandbox workspace (which would clobber the project name).
    prev=""
    for a in "$@"; do
        if [[ "$prev" == "--filter" && "$a" == "label=dev.snowdon.opencode.parent="* ]]; then
            if [[ -n "${OPENCODE_TEST_WORKTREE_CHILD:-}" &&
                "${a#label=dev.snowdon.opencode.parent=}" == "$PWD" ]]; then
                # One id per line, as docker ps -q prints them.
                printf '%s\n' ${OPENCODE_TEST_WORKTREE_CHILD}
            fi
            exit 0
        fi
        prev="$a"
    done
    # Normal case: report a single managed container. With the -q flag only the
    # container id is printed, otherwise the "<id>\t<workspace>" form. When
    # OPENCODE_TEST_CONFLICT=1 the inspect mock returns a *different* workspace
    # so the launcher can exercise its coexistence warning. When a worktree
    # child is scripted, it is reported together with the generic container.
    quiet=0
    for a in "$@"; do [[ "$a" == "-q" ]] && quiet=1; done
    # Exit 0 explicitly: the launcher runs under `set -e` and propagates the
    # mock's status via `ps_rc=$?` inside _managed_container_ids, so a trailing
    # failing [[ ]] here would abort the caller.
    if [[ "$quiet" == "1" ]]; then
        echo "c1"
        if [[ -n "${OPENCODE_TEST_WORKTREE_CHILD:-}" ]]; then
            # One id per line, as docker ps -q prints them.
            printf '%s\n' ${OPENCODE_TEST_WORKTREE_CHILD}
        fi
        exit 0
    elif [[ "${OPENCODE_TEST_CONFLICT:-}" == "1" ]]; then
        echo "c1	/workspace/other"
        exit 0
    fi
    echo "c1	$PWD"
    exit 0
elif [[ "$1" == "inspect" ]]; then
    shift
    # Every container inspect goes through the launcher's _container_info /
    # _container_infos helpers, whose tab-separated record is: id, status,
    # workspace, project, oneoff, tui, parent, sentinel; the launcher splits it
    # with _rec_fields, which preserves empty columns. With
    # OPENCODE_TEST_CONFLICT=1 the workspace resolves to a
    # different path so the launcher can see a coexisting container and warn
    # about it. The scripted worktree-child containers
    # (OPENCODE_TEST_WORKTREE_CHILD, space-separated ids) resolve to
    # OPENCODE_TEST_WORKTREE_CHILD_PATH with their parent repo ($PWD).
    #
    # The tui column is deliberately EMPTY for these main containers, like real
    # docker inspect output: only the tui service carries
    # dev.snowdon.opencode.tui (docker-compose.yml), so
    # {{index .Config.Labels "dev.snowdon.opencode.tui"}} renders as an empty
    # column for every other container. Printing a value there would hide
    # record-parsing bugs that only bite when a column is empty.
    #
    # The launcher batches the listing's discovery into a single
    # `docker inspect --format <template> <id>...` call, and inspects single ids
    # elsewhere, so provide a record for every id argument.
    [[ "$1" == "--format" ]] && shift 2
    cid=""
    for cid in "$@"; do
        for child in ${OPENCODE_TEST_WORKTREE_CHILD:-}; do
            if [[ "$cid" == "$child" ]]; then
                printf '%s\t%s\t%s\t%s\tfalse\t\t%s\t.\n' \
                    "$cid" "running" "$OPENCODE_TEST_WORKTREE_CHILD_PATH" "wt-proj" "$PWD"
                continue 2
            fi
        done
        ws="$PWD"
        if [[ "${OPENCODE_TEST_CONFLICT:-}" == "1" ]]; then
            ws="/workspace/other"
        fi
        printf '%s\t%s\t%s\tws\tfalse\t\t\t.\n' "$cid" "${OPENCODE_TEST_STATUS:-running}" "$ws"
    done
elif [[ "$1" == "rm" ]]; then
    shift
    echo "mocked: rm $*"
elif [[ "$1" == "exec" ]]; then
    # docker exec is used by the launcher's idle detection (ls table). Consume
    # the container id, then simulate `pgrep -f 'opencode'`: exit 0 when an
    # opencode process is present, exit 1 when it is not
    # (OPENCODE_TEST_NO_SERVE=1), so ls can report "idle".
    shift
    cid="${1:-}"
    shift
    if [[ "${1:-}" == "pgrep" ]]; then
        if [[ "${OPENCODE_TEST_NO_SERVE:-}" == "1" ]]; then
            exit 1
        fi
        exit 0
    fi
    echo "mocked: exec $cid $*"
elif [[ "$1" == "image" && "${2:-}" == "ls" ]]; then
    # docker image ls [-q] --filter label=dev.snowdon.opencode.workspace[=<ws>]
    # Scripted ids feed the delete --all cleanup. Per label:
    #   OPENCODE_TEST_IMAGE_WS_MAP      "<ws>=<id> ..." for
    #                                    label=dev.snowdon.opencode.workspace=<ws>
    #   OPENCODE_TEST_IMAGE_WS          ids for that same query when no map is set
    #                                    (the current workspace's image, which
    #                                    --other must preserve)
    #   OPENCODE_TEST_IMAGE_PARENT_MAP  "<parent ws>=<id> ..." for
    #                                    label=dev.snowdon.opencode.workspace_parent=<ws>
    #                                    (the worktree image whose repository is <ws>)
    #   OPENCODE_TEST_IMAGES            the full set, for a bare workspace filter
    shift 2
    ws_value=""
    parent_value=""
    prev=""
    for a in "$@"; do
        if [[ "$prev" == "--filter" ]]; then
            case "$a" in
            label=dev.snowdon.opencode.workspace=*)
                ws_value="${a#label=dev.snowdon.opencode.workspace=}"
                ;;
            label=dev.snowdon.opencode.workspace_parent=*)
                parent_value="${a#label=dev.snowdon.opencode.workspace_parent=}"
                ;;
            esac
        fi
        prev="$a"
    done
    if [[ -n "$parent_value" ]]; then
        mock_ls_filter "$parent_value" "${OPENCODE_TEST_IMAGE_PARENT_MAP:-}" ""
    elif [[ -n "$ws_value" ]]; then
        mock_ls_filter "$ws_value" "${OPENCODE_TEST_IMAGE_WS_MAP:-}" \
            "${OPENCODE_TEST_IMAGE_WS:-}"
    else
        mock_ls_filter "" "" "${OPENCODE_TEST_IMAGES:-}"
    fi
    exit 0
elif [[ "$1" == "network" && "${2:-}" == "ls" ]]; then
    # docker network ls [-q] --filter label=dev.snowdon.opencode.managed or
    # --filter label=dev.snowdon.opencode.workspace[=<ws>] or
    # --filter label=dev.snowdon.opencode.workspace_parent=<ws>. As for images,
    # OPENCODE_TEST_NETWORK_WS is the current workspace's network (preserved by
    # --other), OPENCODE_TEST_NETWORKS the full managed set, and
    # OPENCODE_TEST_NETWORK_WS_MAP / OPENCODE_TEST_NETWORK_PARENT_MAP script a
    # network per workspace and per worktree parent.
    shift 2
    ws_value=""
    parent_value=""
    for a in "$@"; do
        case "$a" in
        label=dev.snowdon.opencode.workspace=*)
            ws_value="${a#label=dev.snowdon.opencode.workspace=}"
            ;;
        label=dev.snowdon.opencode.workspace_parent=*)
            parent_value="${a#label=dev.snowdon.opencode.workspace_parent=}"
            ;;
        esac
    done
    if [[ -n "$parent_value" ]]; then
        mock_ls_filter "$parent_value" "${OPENCODE_TEST_NETWORK_PARENT_MAP:-}" ""
    elif [[ -n "$ws_value" ]]; then
        mock_ls_filter "$ws_value" "${OPENCODE_TEST_NETWORK_WS_MAP:-}" \
            "${OPENCODE_TEST_NETWORK_WS:-}"
    else
        mock_ls_filter "" "" "${OPENCODE_TEST_NETWORKS:-}"
    fi
    exit 0
elif [[ "$1" == "network" && "${2:-}" == "create" ]]; then
    # docker network create [flags] <name>: succeeds unless the test scripts a
    # failure (OPENCODE_TEST_NETWORK_CREATE_FAIL=1), which is how
    # _explain_network_create_failure is reached. The error mirrors docker's
    # own wording for the duplicate-name case and, like docker's, goes to
    # stderr, where the launcher leaves it.
    if [[ "${OPENCODE_TEST_NETWORK_CREATE_FAIL:-}" == "1" ]]; then
        echo "Error response from daemon: network with name ${!#} already exists" >&2
        exit 1
    fi
    exit 0
elif [[ "$1" == "network" && "${2:-}" == "inspect" ]]; then
    # docker network inspect <id-or-name> --format <template>
    # Scripted by OPENCODE_TEST_NETWORK_NAME_MAP, a "<id-or-name>=<workspace>"
    # list of the networks that exist; an empty workspace (name=) stands for a
    # network the launcher did not create, so it carries no workspace label.
    # The launcher reads a network's name ({{.Name}}) and its workspace label
    # (an index of dev.snowdon.opencode.workspace) back from these templates: a
    # target outside the map fails like docker's "no such network", and any
    # other template keeps the old unhandled answer, which is how the IPAM
    # subnet listing (find_free_network) still sees nothing usable.
    mock_net_orig="$*"
    shift 2
    mock_net_fmt=""
    mock_net_target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --format)
            mock_net_fmt="${2:-}"
            shift 2
            ;;
        --format=*)
            mock_net_fmt="${1#--format=}"
            shift
            ;;
        -*)
            shift
            ;;
        *)
            mock_net_target="$1"
            shift
            ;;
        esac
    done
    mock_net_found=0
    mock_net_owner=""
    for mock_net_entry in ${OPENCODE_TEST_NETWORK_NAME_MAP:-}; do
        if [[ "${mock_net_entry%%=*}" == "$mock_net_target" ]]; then
            mock_net_found=1
            mock_net_owner="${mock_net_entry#*=}"
            break
        fi
    done
    if [[ "$mock_net_found" -eq 0 ]]; then
        echo "Error: No such network: $mock_net_target" >&2
        exit 1
    fi
    case "$mock_net_fmt" in
    *'{{.Name}}'*)
        printf '%s\n' "$mock_net_target"
        ;;
    *dev.snowdon.opencode.workspace*)
        printf '%s\n' "$mock_net_owner"
        ;;
    *)
        echo "mocked: unknown $mock_net_orig"
        ;;
    esac
    exit 0
else
    echo "mocked: unknown $*"
fi
