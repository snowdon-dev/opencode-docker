FROM alpine:3.24
ARG DEVCONTAINER_VERSION
ARG USERNAME=other
ARG USER_UID=1000
ARG USER_GID=1000
LABEL dev.snowdon.image.opencode.devcontainer="${DEVCONTAINER_VERSION}"
LABEL dev.snowdon.image.opencode.variant="empty"
LABEL dev.snowdon.opencode.managed=true

## TODO: handle any files left in /root from the opencode base

ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# ------------------------------------------------------------
# User setup
# ------------------------------------------------------------
# Define build arguments for your host user

# Create the group and user inside the container
RUN addgroup -g $USER_GID $USERNAME \
    && adduser -D -u $USER_UID -G $USERNAME $USERNAME \
    && mkdir -p \
        /home/$USERNAME/.local/state \
        /home/$USERNAME/.local/share \
        /home/$USERNAME/.config \
    && chown -R $USER_UID:$USER_GID /home/$USERNAME

# ------------------------------------------------------------
# Packages setup
# ------------------------------------------------------------
# Minimal CLI toolset common to every variant. Language runtimes live in the
# duck and full layers.
#
# Versions are pinned with apk's "~" prefix-match operator, which fixes the major
# version while still absorbing minor updates and Alpine -rN security rebuilds.
# jq~1 tracks 1.8.2 -> 1.9.x but a 2.0.0 release fails the build loudly instead
# of silently upgrading. Bump the digit(s) when a major bump is intended.
RUN apk add --no-cache \
    bash~5 \
    curl~8 \
    diffutils~3 \
    gawk~5 \
    git~2 \
    libgcc~15 \
    libpcap-dev~1 \
    libstdc++~15 \
    make~4 \
    neovim~0 \
    ripgrep~15 \
    actionlint~1 \
    bats~1 \
    fd~10 \
    github-cli~2 \
    jo~1 \
    jq~1 \
    shellcheck~0 \
    yamllint~1 \
    yq~4


ENV EDITOR=nvim
ENV VISUAL=nvim

# Smoke tests for system packages
RUN git --version \
    && curl --version \
    && make --version \
    && rg --version \
    && bash --version \
    && awk --version \
    && diff --version \
    && nvim --version \
    && bats --version \
    && shellcheck --version \
    && fd --version \
    && jq --version \
    && yq --version \
    && jo -v \
    && yamllint --version \
    && actionlint --version \
    && gh --version

# ------------------------------------------------------------
# Start user config
# ------------------------------------------------------------
# Switch to the non-root user
USER $USERNAME

# ------------------------------------------------------------
# End
# ------------------------------------------------------------

ENV HOME="/home/${USERNAME}"
ENV XDG_STATE_HOME="/home/${USERNAME}/.local/state"
ENV XDG_DATA_HOME="/home/${USERNAME}/.local/share"
ENV XDG_CACHE_HOME="/home/${USERNAME}/.cache"
ENV XDG_CONFIG_HOME="/home/${USERNAME}/.config"

# Workspace used by opencode
WORKDIR /workspace/project
ENV HOME=/home/$USERNAME
