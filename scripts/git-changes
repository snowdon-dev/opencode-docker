#!/bin/sh

# Print a git command before running it, so the report shows which commands
# produced the output below. Only the commands whose output reaches stdout go
# through it: the counting helpers are captured by the script and stay out of
# the report, their numbers are not commands the reader needs to see.
run() {
    printf '$ %s\n' "$*"
    "$@"
}

upstream=$(git rev-parse --abbrev-ref @{upstream} 2>/dev/null || true)
echo "Branch: $(git branch --show-current 2>/dev/null || echo detached)"

if [ -n "$upstream" ]; then
    # Count added lines across the complete change set
    added=$(git diff "$upstream"...HEAD --numstat | awk "{sum += \$1} END {print sum+0}")
    working_added=$(git diff --numstat | awk "{sum += \$1} END {print sum+0}")
    staged_added=$(git diff --cached --numstat | awk "{sum += \$1} END {print sum+0}")

    total_added=$((added + working_added + staged_added))
    if [ "$total_added" -gt 500 ]; then
        run git diff --stat "$upstream"...HEAD
        run git diff --stat --cached
        run git diff --stat
    else
        # Show all changes: committed + staged + unstaged
        run git diff "$upstream"...HEAD
        run git diff --cached
        run git diff
    fi
else
    added=$(git diff --numstat | awk "{sum += \$1} END {print sum+0}")
    staged_added=$(git diff --cached --numstat | awk "{sum += \$1} END {print sum+0}")

    total_added=$((added + staged_added))
    if [ "$total_added" -gt 500 ]; then
        run git diff --stat --cached
        run git diff --stat
    else
        run git diff --cached
        run git diff
    fi
fi

echo "Untracked files:"
run git ls-files --others --exclude-standard
